# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret key - Backend / Server-side only (NUNCA expor no frontend)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Provedor de IA Primário (Recepcionista Virtual e Anamnese com IA - OpenAI)
# Modelo econômico e ágil padrão: gpt-4o-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Provedor de IA Alternativo (Secundário / Desativado se OPENAI_API_KEY estiver presente)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Gateway de Assinaturas da Plataforma (Asaas)
# sandbox (padrão) ou production
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
